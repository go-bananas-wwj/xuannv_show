# =============================================================================
# 玄女底座展示平台 — 环境变量配置模板
# =============================================================================
# 复制此文件为 .env 并修改值，或直接在 shell 中 export 对应变量。
# Pydantic Settings 自动映射：embeddings_dir → EMBEDDINGS_DIR
#
# 项目内部路径（frontend/, static_assets/, scripts/）自动推导，无需配置。
# 以下均为外部依赖路径，在当前部署环境中默认值正确，其他环境请覆盖。
# =============================================================================

# ── 项目根目录（自动推导，通常无需覆盖）──
# PROJECT_ROOT=/workspace/xuannv_show

# ── Xuannv Foundations 核心代码仓库 ──
XUANNV_ROOT=/workspace/xuannv

# ── 原始数据根目录 ──
DATA_ROOT=/workspace/raw
RAW_SCENES_DIR=/workspace/raw/harbin_scenes
RAW_FALLBACK_DIR=/workspace/raw/harbin

# ── Embedding 张量目录（分散格式 .npy）──
EMBEDDINGS_DIR=/workspace/raw/xuannv_modelscope_upload/embeddings/v5_mixed_scale/monthly_embeddings_2025

# ── 模型输出根目录 ──
OUTPUTS_ROOT=/workspace/outputs

# ── 变化检测 CD Head 模型权重 ──
CD_HEAD_PATH=/workspace/outputs/aef_qwen_v5_mixed_scale/monthly_cd_head/monthly_cd_head_v5_final.pt

# ── 下游任务预计算结果图目录 ──
RESULTS_DIR=/workspace/outputs/aef_qwen_v5_mixed_scale/results

# ── SAM3 模型 checkpoint ──
SAM3_CHECKPOINT=/workspace/models/facebook/sam3/sam3.pt

# ── 地区配置 ──
REGION=harbin

# ── 中文字体路径（不存在时回退到 DejaVu Sans）──
FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-microhei.ttc

# ── Web 配置 ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOW_ALL_ORIGINS=false

# ── API Key（设置后启用 /api/* 校验，留空则关闭）──
# API_KEY=

# ── DeepSeek API Key（Agent 智能体功能必需）──
DEEPSEEK_API_KEY=

# ── ModelScope Token（静态资源上传必需）──
MODELSCOPE_TOKEN=
